<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>📝 <%= title %></h1>
            <a href="/add" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Todo
            </a>
        </header>

        <div class="todos-container">
            <% if (todos.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-tasks"></i>
                    <p>No todos yet. Create your first todo!</p>
                </div>
            <% } else { %>
                <% todos.forEach(todo => { %>
                    <div class="todo-card priority-<%= todo.priority %>">
                        <div class="todo-header">
                            <div class="todo-title">
                                <h3><%= todo.name %></h3>
                                <span class="priority-badge priority-<%= todo.priority %>">
                                    <%= todo.priority %>
                                </span>
                                <span class="status-badge status-<%= todo.status %>">
                                    <%= todo.status %>
                                </span>
                            </div>
                            <div class="todo-actions">
                                <form action="/toggle/<%= todo.id %>" method="POST" style="display: inline;">
                                    <button type="submit" class="btn-toggle" title="Toggle status">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </form>
                                <a href="/edit/<%= todo.id %>" class="btn-edit" title="Edit todo">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="/delete/<%= todo.id %>" method="POST" style="display: inline;" 
                                      onsubmit="return confirm('Are you sure you want to delete this todo?');">
                                    <button type="submit" class="btn-delete" title="Delete todo">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="todo-description">
                            <p><%= todo.description %></p>
                        </div>
                        <div class="todo-footer">
                            <span class="date-created">
                                <i class="far fa-clock"></i>
                                <%= new Date(todo.createdAt).toLocaleDateString() %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</body>
</html>